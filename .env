# .env.ps1
# hyperion epm environment configuration - dev
# shared across start.ps1, stop.ps1, and healthcheck.ps1
# dot-source this file at the top of each script

# ============================================================================
# server topology
# ============================================================================
$Global:FOU = "chi-dhypfou.adp1.cibc.pte"
$Global:HFM = "chi-dhyphfm.adp1.cibc.pte"
$Global:ESS = "chi-dhypess.adp1.cibc.pte"

# ============================================================================
# hyperion config object - used by healthcheck.ps1
# ============================================================================
$Global:HyperionConfig = @{

    Urls = @{
        Workspace    = "https://hyperion-dev.us.cibc.com/workspace/index.jsp"
        Essbase      = "https://hyperion-dev.us.cibc.com/essbase/jet"
        DodecaTomcat = "https://chi-dhypess.adp1.cibc.pte:8443"
        DodecaMeta   = "https://chi-dhypess.adp1.cibc.pte:8443/dodeca/metadata-service"
        Console      = "http://chi-dhypfou.adp1.cibc.pte:7001/console"
    }

    Services = @(
        @{ Sequence = 1;  Server = "chi-dhypfou.adp1.cibc.pte"; ServiceName = "Oracle WebLogic_AdminServer";                                                   StepName = "WebLogic Admin Server" }
        @{ Sequence = 2;  Server = "chi-dhypfou.adp1.cibc.pte"; ServiceName = "HyS9FoundationServices_epmsystem1";                                             StepName = "Foundation Services" }
        @{ Sequence = 3;  Server = "chi-dhypfou.adp1.cibc.pte"; ServiceName = "Oracle Weblogic ohs NodeManager (D_Oracle_Middleware_ohs_wlserver)";             StepName = "OHS Node Manager" }
        @{ Sequence = 4;  Server = "chi-dhyphfm.adp1.cibc.pte"; ServiceName = "HyS9FinancialManagementJavaServer_epmsystem1";                                  StepName = "HFM Java Server" }
        @{ Sequence = 5;  Server = "chi-dhyphfm.adp1.cibc.pte"; ServiceName = "HyS9FinancialManagementWeb_epmsystem1";                                         StepName = "HFM Web" }
        @{ Sequence = 6;  Server = "chi-dhypfou.adp1.cibc.pte"; ServiceName = "HyS9FRReports_epmsystem1";                                                      StepName = "Financial Reporting" }
        @{ Sequence = 7;  Server = "chi-dhyphfm.adp1.cibc.pte"; ServiceName = "HyS9aifWeb_epmsystem1";                                                         StepName = "FDMEE" }
        @{ Sequence = 8;  Server = "chi-dhypfou.adp1.cibc.pte"; ServiceName = "HyS9CALC_epmsystem1";                                                           StepName = "Calc Manager" }
        @{ Sequence = 9;  Server = "chi-dhypess.adp1.cibc.pte"; ServiceName = "Tomcat10";                                                                       StepName = "Apache Tomcat 10.1" }
        @{ Sequence = 10; Server = "chi-dhypess.adp1.cibc.pte"; ServiceName = "EssbaseService";                                                                 StepName = "Essbase 21C" }
    )

    Repository = @{
        Server   = "chi-dhypsql.adp1.cibc.pte"
        Database = "HYPESB"
    }

    SqlMi = @{
        Server   = "dsql-canc-61856b-dev-01.9b55b202cb72.database.windows.net"
        Database = "FinanceModernization"
    }

    NativeLogs = @{
        EssbaseLog = "D:\Oracle\Middleware\user_projects\domains\essbase_domain\servers\essbase_server1\logs\essbase_server1.log"
        Pattern    = "RUNNING mode"
    }

    AccessGroups = @(
        "Grp_Dom_Global_Access_ADP1"
        "Grp_Dom_Access-FIP1-PTE"
    )

    ServiceAccountPattern = "SVC-CBU-Hyperion"
}

# ============================================================================
# services in startup order - used by start.ps1
# ============================================================================
$Global:StartupSequence = $Global:HyperionConfig.Services | Sort-Object Sequence | ForEach-Object {
    @{ Server = $_.Server; Service = $_.ServiceName; Desc = $_.StepName; Wait = switch ($_.Sequence) {
        1  { 60 }
        2  { 30 }
        3  { 15 }
        4  { 30 }
        5  { 30 }
        6  { 30 }
        7  { 60 }
        8  { 30 }
        9  { 30 }
        10 { 60 }
    }}
}

# ============================================================================
# ohs special case
# ============================================================================
$Global:OHSServer             = $Global:FOU
$Global:OHSStartComponentPath = "D:\Oracle\Middleware\user_projects\epmsystem1\httpConfig\ohs\bin\startComponent.cmd"
$Global:OHSComponentName      = "ohs_component"
$Global:OHSWaitAfterStart     = 30

# ============================================================================
# timeouts
# ============================================================================
$Global:TimeoutSeconds       = 300
$Global:EssbaseStatusTimeout = 600

# ============================================================================
# alert settings
# ============================================================================
$Global:SendEmail    = $true
$Global:SmtpServer   = "smtp.cibc.com"
$Global:EmailFrom    = "alert@cibc.com"
$Global:EmailTo      = @("xavier.borja@cibc.com")
$Global:EmailSubject = "HYPERION DEV - SERVICE STARTUP FAILURE"

# ============================================================================
# logging
# ============================================================================
$Global:LogDir = "D:\Oracle\scripts\Logs"
if (!(Test-Path $Global:LogDir)) { New-Item -ItemType Directory -Path $Global:LogDir -Force | Out-Null }

# ============================================================================
# essbase validation paths
# ============================================================================
$Global:EssbaseServer = $Global:ESS
$Global:StatusCmdPath = "D:\Oracle\Middleware\user_projects\domains\essbase_domain\esstools\bin\status.cmd"
$Global:MaxLPath      = "D:\Oracle\Middleware\user_projects\domains\essbase_domain\esstools\bin\startMaxl.cmd"
$Global:MaxLScript    = "D:\scripts\ValidateEssbase.mxl"
